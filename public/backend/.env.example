# Copy to .env and fill in your Supabase project values
# Find these in Supabase Dashboard -> Settings -> API

# Shared project URL (also used by the frontend)
SUPABASE_URL=https://YOUR_PROJECT.ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key. NEVER expose this to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Google Maps API key to compute real delivery distance for freight.
# When absent, freight is estimated from pincode distance heuristics.
GOOGLE_MAPS_API_KEY=

# --- Email notifications (Gmail SMTP via Nodemailer) -------------------------
# Notifications are sent directly to the owner's inbox via smtp.gmail.com:465.
EMAIL_USER=zamirulrasmi30@gmail.com
EMAIL_PASS=your-gmail-app-password
# Owner inbox to notify. Defaults to EMAIL_USER if left blank.
EMAIL_OWNER=

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# GST config
GST_RATE=18
FREIGHT_BASE=500
FREIGHT_PER_KM=18